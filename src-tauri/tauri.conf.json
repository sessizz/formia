{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Formia",
  "version": "1.0.0",
  "identifier": "com.sessizz.formia",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Formia",
        "width": 1320,
        "height": 840,
        "minWidth": 760,
        "minHeight": 480,
        "dragDropEnabled": false,
        "backgroundColor": "#141518"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "3D model önizlemeli dosya gezgini",
    "longDescription": "STL, 3MF, OBJ, STEP ve diğer 3D dosyalarını küçük resimlerle listeleyen, boşluk tuşuyla büyük önizleme açan dosya gezgini.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"]
      }
    }
  }
}
